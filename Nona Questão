texto = input("Digite uma palavra: ").lower()

vogais = "aeiou"
count_vogais = 0
count_consoantes = 0

for letra in texto:
    if letra.isalpha():
        if letra in vogais:
            count_vogais += 1
        else:
            count_consoantes += 1

print(f"Vogais: {count_vogais}")
print(f"Consoantes: {count_consoantes}") 